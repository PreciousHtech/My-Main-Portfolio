# ==========================================
# Server Environment Variables (Backend)
# ==========================================
PORT=3000
GITHUB_USERNAME=PreciousHtech
# GITHUB_TOKEN: GitHub personal access token (used server-side to prevent rate limits)
GITHUB_TOKEN=
# Topic to filter repos by (tag your repositories on GitHub with this topic)
GITHUB_FEATURED_TOPIC=portfolio
# Optional comma-separated repo names to pin top display order
PROJECT_ORDER=Great_Star_Gem_Technologies_Limited,Suxul-E-commerce,Machine-Translator,Movie-Website

# Destination email inbox where inquiries will arrive:
CONTACT_TO_EMAIL=precioushart205@gmail.com

# Email Delivery Configuration (Resend API key from https://resend.com)
RESEND_API_KEY=
RESEND_API=

# CLIENT_ORIGIN:
# The frontend origin(s) allowed to make API requests (CORS protection).
# Can be a single URL or comma-separated list.
# - Local dev: http://localhost:3000
# - Production: https://your-portfolio.vercel.app or your custom domain
CLIENT_ORIGIN=https://ais-dev-rksbqhbhc6njbs7fcmctfd-621848882415.europe-west2.run.app,https://ais-pre-rksbqhbhc6njbs7fcmctfd-621848882415.europe-west2.run.app,http://localhost:3000

# ==========================================
# Client Environment Variables (Frontend Vite)
# ==========================================
# VITE_API_URL:
# Base URL for backend API requests.
# - In fullstack / monorepo / Cloud Run (same-origin): set to /api
# - In separated deployment (e.g. Vercel frontend calling Render backend):
#   set to https://your-render-backend.onrender.com/api
VITE_API_URL=/api

# VITE_GITHUB_URL:
# The public GitHub profile link rendered in Hero, Contact, and Footer.
VITE_GITHUB_URL=https://github.com/PreciousHtech

# VITE_CONTACT_EMAIL:
# The direct contact email shown to visitors in the UI.
VITE_CONTACT_EMAIL=precioushart205@gmail.com
